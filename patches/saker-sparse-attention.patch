diff --git a/src/llama-saker-sparse.h b/src/llama-saker-sparse.h
new file mode 100644
index 0000000..c2bdaac
--- /dev/null
+++ b/src/llama-saker-sparse.h
@@ -0,0 +1,160 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <limits>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+struct saker_sparse_config {
+    int tokens = 0;
+    int block = 16;
+    int recent_blocks = 16;
+    int sink_blocks = 1;
+    int max_batch = 8;
+};
+
+inline int saker_sparse_env_int(const char * name, int fallback, int maximum) {
+    const char * value = std::getenv(name);
+    if (!value) {
+        return fallback;
+    }
+    char * end = nullptr;
+    errno = 0;
+    const long parsed = std::strtol(value, &end, 10);
+    if (errno || end == value || *end || parsed < 0 || parsed > maximum) {
+        throw std::invalid_argument(std::string(name) + " must be an integer between 0 and " + std::to_string(maximum));
+    }
+    return int(parsed);
+}
+
+inline const saker_sparse_config & saker_sparse_options() {
+    static const saker_sparse_config config = [] {
+        saker_sparse_config result;
+        result.tokens = saker_sparse_env_int("SAKER_SPARSE_TOKENS", 0, 8192);
+        if (result.tokens == 0) {
+            return result;
+        }
+        result.recent_blocks = saker_sparse_env_int("SAKER_SPARSE_RECENT_BLOCKS", 16, 511);
+        result.sink_blocks = saker_sparse_env_int("SAKER_SPARSE_SINK_BLOCKS", 1, 511);
+        if (result.tokens % result.block ||
+                result.tokens / result.block <= result.recent_blocks + result.sink_blocks) {
+            throw std::invalid_argument("SAKER_SPARSE_TOKENS must be a multiple of 16 with room for protected blocks and retrieval");
+        }
+        return result;
+    }();
+    return config;
+}
+
+// Each representative must be visible to this query, including in a verification batch.
+inline void saker_sparse_fill_row(
+        const saker_sparse_config & config,
+        const std::vector<int32_t> & positions,
+        const ggml_fp16_t * mask,
+        int32_t * representatives,
+        float * bias) {
+    const int n_blocks = int(positions.size()) / config.block;
+    const int32_t high = std::numeric_limits<int32_t>::max();
+    std::vector<int32_t> first(n_blocks, high), last(n_blocks, -1);
+    std::vector<int> valid;
+    int32_t fallback = 0;
+    for (int b = 0; b < n_blocks; ++b) {
+        representatives[b] = 0;
+        bias[b] = -INFINITY;
+        for (int i = b * config.block; i < (b + 1) * config.block; ++i) {
+            if (positions[i] < 0 || !std::isfinite(ggml_fp16_to_fp32(mask[i]))) {
+                continue;
+            }
+            first[b] = std::min(first[b], positions[i]);
+            if (positions[i] > last[b]) {
+                last[b] = positions[i];
+                representatives[b] = i;
+                fallback = i;
+            }
+        }
+        if (last[b] >= 0) {
+            bias[b] = 0.0f;
+            valid.push_back(b);
+        }
+    }
+    for (int b = 0; b < n_blocks; ++b) {
+        if (last[b] < 0) {
+            representatives[b] = fallback;
+        }
+    }
+
+    const auto protect = [&](int count, bool recent) {
+        count = std::min(count, int(valid.size()));
+        std::partial_sort(valid.begin(), valid.begin() + count, valid.end(), [&](int a, int b) {
+            const int32_t pa = recent ? last[a] : first[a];
+            const int32_t pb = recent ? last[b] : first[b];
+            return pa == pb ? a < b : (recent ? pa > pb : pa < pb);
+        });
+        for (int i = 0; i < count; ++i) {
+            bias[valid[i]] = INFINITY;
+        }
+    };
+    protect(config.recent_blocks, true);
+    protect(config.sink_blocks, false);
+}
+
+struct saker_sparse_selection {
+    ggml_tensor * q;
+    ggml_tensor * k;
+    ggml_tensor * v;
+    ggml_tensor * mask;
+    ggml_tensor * blocks;
+};
+
+// Input Q is [D, Hq, T]; K/V are packed cache views [D, Hkv, N, 1].
+inline saker_sparse_selection saker_sparse_select(
+        ggml_context * ctx,
+        const saker_sparse_config & config,
+        ggml_tensor * q,
+        ggml_tensor * k,
+        ggml_tensor * v,
+        ggml_tensor * mask,
+        ggml_tensor * representatives,
+        ggml_tensor * bias,
+        int token) {
+    const int64_t n_blocks = k->ne[2] / config.block;
+    const int n_selected = std::min<int64_t>(config.tokens / config.block, n_blocks);
+    GGML_ASSERT(n_selected > 0 && k->ne[2] % config.block == 0);
+    GGML_ASSERT(k->ne[3] == 1 && v->ne[3] == 1);
+    GGML_ASSERT(k->nb[2] == ggml_row_size(k->type, k->ne[0] * k->ne[1]));
+    GGML_ASSERT(v->nb[2] == ggml_row_size(v->type, v->ne[0] * v->ne[1]));
+    GGML_ASSERT(mask->type == GGML_TYPE_F16);
+
+    auto * qi = ggml_view_3d(ctx, q, q->ne[0], q->ne[1], 1, q->nb[1], q->nb[2], token * q->nb[2]);
+    auto * ri = ggml_view_1d(ctx, representatives, n_blocks, token * representatives->nb[1]);
+    auto * bi = ggml_view_1d(ctx, bias, n_blocks, token * bias->nb[1]);
+    auto * k_rows = ggml_view_2d(ctx, k, k->ne[0] * k->ne[1], k->ne[2], k->nb[2], 0);
+    auto * proxy = ggml_get_rows(ctx, k_rows, ri);
+    proxy = ggml_permute(ctx, ggml_reshape_3d(ctx, proxy, k->ne[0], k->ne[1], n_blocks), 0, 2, 1, 3);
+    auto * scores = ggml_mul_mat(ctx, proxy, ggml_permute(ctx, qi, 0, 2, 1, 3));
+    ggml_mul_mat_set_prec(scores, GGML_PREC_F32);
+    scores = ggml_reshape_2d(ctx, scores, n_blocks, q->ne[1]);
+    scores = ggml_pool_2d(ctx, scores, GGML_OP_POOL_MAX, 1, int(q->ne[1]), 1, int(q->ne[1]), 0, 0);
+    scores = ggml_add(ctx, ggml_reshape_1d(ctx, scores, n_blocks), bi);
+    auto * selected = ggml_top_k(ctx, scores, n_selected);
+
+    const auto gather = [&](ggml_tensor * cache) {
+        const int64_t width = cache->ne[0] * cache->ne[1];
+        auto * blocks = ggml_view_2d(ctx, cache, width * config.block, n_blocks, cache->nb[2] * config.block, 0);
+        auto * compact = ggml_get_rows(ctx, blocks, selected);
+        compact = ggml_cast(ctx, compact, GGML_TYPE_F16);
+        return ggml_reshape_3d(ctx, compact, cache->ne[0], cache->ne[1], n_selected * config.block);
+    };
+
+    auto * mi = ggml_view_2d(ctx, mask, config.block, n_blocks, config.block * mask->nb[0], token * mask->nb[1]);
+    mi = ggml_get_rows(ctx, mi, selected);
+    mi = ggml_cast(ctx, ggml_reshape_2d(ctx, mi, n_selected * config.block, 1), GGML_TYPE_F16);
+    return {qi, gather(k), gather(v), mi, selected};
+}
