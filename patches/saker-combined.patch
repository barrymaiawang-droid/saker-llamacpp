+// ----------------------------------------------------------------------------
+// saker: MTP draft-head shortlist
+// ----------------------------------------------------------------------------
+
+static int32_t saker_shortlist_env_k() {
+    const char * e = getenv("SAKER_SHORTLIST");
+    return (e != nullptr && atoi(e) > 0) ? atoi(e) : 0;
+}
+
+llama_model::saker_mtp_shortlist::~saker_mtp_shortlist() {
+    if (buf) {
+        ggml_backend_buffer_free(buf);
+    }
+    if (ctx) {
+        ggml_free(ctx);
+    }
+}
+
+ggml_tensor * llama_model::saker_mtp_shortlist_get() const {
+    const int32_t k = saker_shortlist_env_k();
+    if (k == 0 || output == nullptr) {
+        return nullptr;
+    }
+    if (mtp_shortlist && !mtp_shortlist->enabled) {
+        return nullptr;   // disabled for this round: draft against the full head
+    }
+    if (!mtp_shortlist) {
+        mtp_shortlist = std::make_unique<saker_mtp_shortlist>();
+        mtp_shortlist->k = k;
+
+        struct ggml_init_params ip = {
+            /*.mem_size   =*/ 64*1024,
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        mtp_shortlist->ctx = ggml_init(ip);
+        const int64_t saker_ne[1] = { mtp_shortlist->k };
+        mtp_shortlist->ids = ggml_new_tensor(mtp_shortlist->ctx, GGML_TYPE_I32, 1, saker_ne);
+
+        mtp_shortlist->buf = ggml_backend_alloc_ctx_tensors_from_buft(mtp_shortlist->ctx, ggml_backend_cpu_buffer_type());
+        GGML_ASSERT(mtp_shortlist->buf != nullptr);
+
+        std::vector<int8_t> zero(ggml_nbytes(mtp_shortlist->ids), 0);
+        ggml_backend_tensor_set(mtp_shortlist->ids, zero.data(), 0, zero.size());
+
+        LLAMA_LOG_INFO("%s: saker MTP shortlist enabled, K = %d\n", __func__, (int) mtp_shortlist->k);
+    }
+    return mtp_shortlist->ids;
+}
+
+int32_t llama_model_mtp_shortlist_k(const struct llama_model * model) {
+    return model != nullptr ? saker_shortlist_env_k() : 0;
+}
+
+bool llama_model_mtp_shortlist_active(const struct llama_model * model) {
+    return model != nullptr && model->mtp_shortlist != nullptr;
+}
+
+void llama_set_mtp_shortlist_enabled(const struct llama_model * model, bool enabled) {
+    if (model == nullptr) {
+        return;
+    }
+    llama_model * m = const_cast<llama_model *>(model);
+    if (m->saker_mtp_shortlist_get() == nullptr && !enabled) {
+        return;   // nothing allocated yet, and nothing to disable
+    }
+    if (m->mtp_shortlist) {
+        m->mtp_shortlist->enabled = enabled;
+    }
+}
+
+void llama_set_mtp_candidates(const struct llama_model * model, const int32_t * ids, int32_t n) {
+    if (model == nullptr) {
+        return;
+    }
+    llama_model * m = const_cast<llama_model *>(model);
+    if (m->saker_mtp_shortlist_get() == nullptr) {
+        return;
+    }
+    const int32_t k = m->mtp_shortlist->k;
+    std::vector<int32_t> host(k, 0);
+    for (int32_t i = 0; i < (n < k ? n : k); ++i) {
+        host[i] = ids != nullptr ? ids[i] : 0;
+    }
+    ggml_backend_tensor_set(m->mtp_shortlist->ids, host.data(), 0, (size_t) k * sizeof(int32_t));
+}
+
