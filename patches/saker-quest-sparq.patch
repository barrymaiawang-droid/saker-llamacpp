diff --git a/tests/saker-quality.cpp b/tests/saker-quality.cpp
new file mode 100644
index 0000000..f977e37
--- /dev/null
+++ b/tests/saker-quality.cpp
@@ -0,0 +1,106 @@
+#include "llama.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <iterator>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+// Teacher-forced one-token decode: bulk perplexity would bypass sparse attention.
+int main(int argc, char ** argv) {
+    if (argc < 4) {
+        std::fprintf(stderr, "usage: saker-quality MODEL CORPUS OUTPUT.csv [prefix=4096] [score=128] [windows=2] [threads=4] [state-check=0]\n");
+        return 1;
+    }
+    const int prefix = argc > 4 ? std::stoi(argv[4]) : 4096;
+    const int score = argc > 5 ? std::stoi(argv[5]) : 128;
+    const int windows = argc > 6 ? std::stoi(argv[6]) : 2;
+    const int threads = argc > 7 ? std::stoi(argv[7]) : 4;
+    const bool state_check = argc > 8 && std::stoi(argv[8]) != 0;
+    if (prefix < 2 || score < 1 || windows < 1 || threads < 1) { return 1; }
+    ggml_backend_load_all();
+    llama_backend_init();
+    auto mp = llama_model_default_params();
+    mp.n_gpu_layers = 0;
+    auto * model = llama_model_load_from_file(argv[1], mp);
+    if (!model) { return 1; }
+    auto cp = llama_context_default_params();
+    cp.n_ctx = prefix + score + 256;
+    cp.n_batch = 512;
+    cp.n_ubatch = 512;
+    cp.n_threads = cp.n_threads_batch = threads;
+    cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+    cp.type_k = cp.type_v = GGML_TYPE_F16;
+    cp.offload_kqv = false;
+    auto * ctx = llama_init_from_model(model, cp);
+    if (!ctx) { llama_model_free(model); return 1; }
+    const auto * vocab = llama_model_get_vocab(model);
+    const int nv = llama_vocab_n_tokens(vocab);
+    std::ifstream file(argv[2], std::ios::binary);
+    const std::string text((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+    int size = -llama_tokenize(vocab, text.data(), text.size(), nullptr, 0, true, false);
+    std::vector<llama_token> tokens(size);
+    size = llama_tokenize(vocab, text.data(), text.size(), tokens.data(), size, true, false);
+    if (size < (prefix + score) * windows) {
+        std::fprintf(stderr, "corpus too short: %d tokens, need %d\n", size, (prefix + score) * windows);
+        llama_free(ctx); llama_model_free(model); llama_backend_free();
+        return 1;
+    }
+    std::ofstream output(argv[3]);
+    output.precision(12);
+    output << "window,step,target,logprob,top1\n";
+    if (!output) { return 1; }
+    double nll = 0;
+    for (int w = 0; w < windows; ++w) {
+        llama_memory_clear(llama_get_memory(ctx), true);
+        const int start = w * (prefix + score);
+        for (int pos = 0; pos < prefix - 1;) {
+            const int count = std::min(512, prefix - 1 - pos);
+            if (llama_decode(ctx, llama_batch_get_one(tokens.data() + start + pos, count))) { return 1; }
+            pos += count;
+        }
+        if (state_check) {
+            std::vector<uint8_t> state(llama_state_get_size(ctx));
+            const size_t written = llama_state_get_data(ctx, state.data(), state.size());
+            if (written != state.size()) { return 1; }
+            if (llama_decode(ctx, llama_batch_get_one(tokens.data() + start + prefix - 1, 1))) { return 1; }
+            const float * logits = llama_get_logits_ith(ctx, -1);
+            std::vector<float> expected(logits, logits + nv);
+            // Overwrite the page, restore the saved cache, then repeat the same query.
+            if (llama_decode(ctx, llama_batch_get_one(tokens.data() + start + prefix, std::min(score, 32)))) { return 1; }
+            if (llama_state_set_data(ctx, state.data(), state.size()) != state.size()) { return 1; }
+            if (llama_decode(ctx, llama_batch_get_one(tokens.data() + start + prefix - 1, 1))) { return 1; }
+            logits = llama_get_logits_ith(ctx, -1);
+            for (int i = 0; i < nv; ++i) {
+                if (!std::isfinite(logits[i]) || std::abs(logits[i] - expected[i]) > 1e-5f * (1 + std::abs(expected[i]))) {
+                    std::fprintf(stderr, "state restore changed logit %d: %g vs %g\n", i, logits[i], expected[i]);
+                    return 1;
+                }
+            }
+            if (llama_state_set_data(ctx, state.data(), state.size()) != state.size()) { return 1; }
+            std::fprintf(stderr, "PASS: state save/restore window=%d\n", w);
+        }
+        for (int t = 0; t < score; ++t) {
+            if (llama_decode(ctx, llama_batch_get_one(tokens.data() + start + prefix - 1 + t, 1))) { return 1; }
+            const float * logits = llama_get_logits_ith(ctx, -1);
+            const int best = std::max_element(logits, logits + nv) - logits;
+            double sum = 0;
+            for (int i = 0; i < nv; ++i) { sum += std::exp(double(logits[i]) - logits[best]); }
+            const int target = tokens[start + prefix + t];
+            const double logprob = logits[target] - logits[best] - std::log(sum);
+            if (!std::isfinite(logprob)) { return 1; }
+            nll -= logprob;
+            output << w << ',' << t << ',' << target << ',' << logprob << ',' << best << '\n';
+        }
+        output.flush();
+        std::fprintf(stderr, "window=%d scored=%d ppl=%.6f\n", w, (w + 1) * score, std::exp(nll / ((w + 1) * score)));
+    }
+    llama_free(ctx);
+    llama_model_free(model);
+    llama_backend_free();
+    return output ? 0 : 1;
+}
