+bool llama_kv_cache::has_saker_quest() const {
+    return !layers.empty() && layers.front().quest_min != nullptr;
+}
+
+std::vector<int32_t> llama_kv_cache::saker_quest_pages(const slot_info & sinfo) const {
+    std::vector<int32_t> pages;
+    if (!has_saker_quest()) { return pages; }
+    const int block = saker_sparse_options().block;
+    if (!quest_valid) {
+        pages.resize(get_size() / block);
+        std::iota(pages.begin(), pages.end(), 0);
+    } else {
+        for (const auto & stream : sinfo.idxs) {
+            for (uint32_t slot : stream) { pages.push_back(slot / block); }
+        }
+        std::sort(pages.begin(), pages.end());
+        pages.erase(std::unique(pages.begin(), pages.end()), pages.end());
+    }
+    return pages;
+}
+
+void llama_kv_cache::saker_quest_complete(bool success) {
+    quest_valid = success;
+}
+
+ggml_tensor * llama_kv_cache::saker_quest_bound(int32_t il, bool maximum) const {
+    const auto & layer = layers[map_layer_ids.at(il)];
+    return maximum ? layer.quest_max : layer.quest_min;
+}
+
+void llama_kv_cache::saker_quest_refresh(ggml_context * ctx, ggml_cgraph * graph,
+        ggml_tensor * pages, int32_t il, const slot_info & sinfo) const {
+    saker_quest_update(ctx, graph, get_k(ctx, il, get_size(), sinfo), pages,
+            saker_quest_bound(il, false), saker_quest_bound(il, true));
+}
+
+std::vector<int32_t> llama_kv_cache_context::saker_quest_pages() const {
+    return kv->saker_quest_pages(sinfos[i_cur]);
+}
+
+void llama_kv_cache_context::saker_quest_complete(bool success) const {
+    kv->saker_quest_complete(success);
+}
+
+void llama_kv_cache_context::saker_quest_refresh(ggml_context * ctx, ggml_cgraph * graph,
+        ggml_tensor * pages, int32_t il) const {
+    kv->saker_quest_refresh(ctx, graph, pages, il, sinfos[i_cur]);
+}
+
+ggml_tensor * llama_kv_cache_context::saker_quest_bound(int32_t il, bool maximum) const {
+    return kv->saker_quest_bound(il, maximum);
+}
+
 ggml_tensor * llama_kv_cache_context::get_v(ggml_context * ctx, int32_t il) const {
     return kv->get_v(ctx, il, n_kv, sinfos[i_cur]);
