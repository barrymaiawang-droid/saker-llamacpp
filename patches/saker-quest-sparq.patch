diff --git a/tests/test-saker-selectors.cpp b/tests/test-saker-selectors.cpp
new file mode 100644
index 0000000..ac28bb1
--- /dev/null
+++ b/tests/test-saker-selectors.cpp
@@ -0,0 +1,281 @@
+#include "llama-saker-sparse.h"
+#include "ggml-backend.h"
+#include "ggml-alloc.h"
+
+#include <cstdio>
+#include <random>
+#include <set>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); std::abort(); } } while (0)
+
+static void supported(ggml_backend_t backend, ggml_cgraph * graph) {
+    for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+        auto * node = ggml_graph_node(graph, i);
+        if (!ggml_backend_supports_op(backend, node)) {
+            std::fprintf(stderr, "unsupported on %s: %s\n", ggml_backend_name(backend), ggml_op_name(node->op));
+            CHECK(false);
+        }
+    }
+}
+
+static std::vector<double> softmax(std::vector<double> x) {
+    const double maximum = *std::max_element(x.begin(), x.end());
+    double total = 0;
+    for (auto & v : x) { v = std::exp(v - maximum); total += v; }
+    for (auto & v : x) { v /= total; }
+    return x;
+}
+
+static void test_selector(ggml_backend_t backend, saker_sparse_mode mode, int nt, bool all, bool fragmented, int channels, bool zero) {
+    constexpr int d = 32, hq = 4, hk = 2, n = 96, capacity = 128, group = hq / hk;
+    saker_sparse_config config;
+    config.mode = mode;
+    config.tokens = all ? n : 48;
+    config.channels = channels;
+    config.recent_blocks = 1;
+    config.sink_blocks = 1;
+    config.recent_tokens = 8;
+    config.sink_tokens = 4;
+    const int unit = config.unit(), count = config.tokens / unit, nb = n / unit;
+    auto * ctx = ggml_init({32 * 1024 * 1024, nullptr, true});
+    CHECK(ctx);
+    auto * q = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, d, hq, nt);
+    auto * ks = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, d, hk, capacity);
+    auto * vs = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, d, hk, capacity);
+    auto * k = ggml_view_4d(ctx, ks, d, hk, n, 1, d * 2, d * hk * 2, capacity * d * hk * 2, 0);
+    auto * v = ggml_view_4d(ctx, vs, d, hk, n, 1, d * 2, d * hk * 2, capacity * d * hk * 2, 0);
+    auto * mask = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, n, nt);
+    auto * bias = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, nb, nt);
+    auto * lo = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, d * hk, capacity / 16);
+    auto * hi = ggml_dup_tensor(ctx, lo);
+    auto * pages = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, capacity / 16);
+    auto * graph = ggml_new_graph_custom(ctx, 8192, false);
+    if (mode == saker_sparse_mode::quest) { saker_quest_update(ctx, graph, ks, pages, lo, hi); }
+    std::vector<saker_sparse_selection> selections;
+    std::vector<ggml_tensor *> outputs;
+    for (int t = 0; t < nt; ++t) {
+        for (int h = 0; h < hk; ++h) {
+            auto s = saker_sparse_select_head(ctx, config, q, k, v, mask, bias, lo, hi, t, h);
+            auto * out = ggml_flash_attn_ext(ctx, ggml_permute(ctx, s.q, 0, 2, 1, 3),
+                    ggml_permute(ctx, s.k, 0, 2, 1, 3), ggml_permute(ctx, s.v, 0, 2, 1, 3),
+                    s.mask, 1.0f / std::sqrt(float(d)), 0, 0);
+            ggml_flash_attn_ext_set_prec(out, GGML_PREC_F32);
+            ggml_build_forward_expand(graph, out);
+            selections.push_back(s);
+            outputs.push_back(out);
+        }
+    }
+    supported(backend, graph);
+    auto buffer = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    CHECK(buffer);
+    std::mt19937 rng(41);
+    std::uniform_real_distribution<float> uniform(-0.7f, 0.7f);
+    std::vector<float> queries(d * hq * nt);
+    std::vector<ggml_fp16_t> keys(d * hk * capacity), values(keys.size()), masks(n * nt);
+    for (auto & x : queries) { x = zero ? 0 : uniform(rng); }
+    for (auto & x : keys) { x = ggml_fp32_to_fp16(uniform(rng)); }
+    for (auto & x : values) { x = ggml_fp32_to_fp16(uniform(rng)); }
+    // Interior keys with opposite signs make a last-key representative insufficient.
+    keys[(17 * hk) * d] = ggml_fp32_to_fp16(4);
+    keys[(34 * hk + 1) * d + 1] = ggml_fp32_to_fp16(-4);
+    const auto original_keys = keys, original_values = values;
+    std::vector<int32_t> positions(n), page_ids(capacity / 16);
+    std::iota(positions.begin(), positions.end(), 0);
+    std::iota(page_ids.begin(), page_ids.end(), 0);
+    if (fragmented) {
+        if (mode == saker_sparse_mode::quest) {
+            std::rotate(positions.begin(), positions.begin() + 32, positions.end());
+        } else {
+            std::shuffle(positions.begin(), positions.end(), rng);
+            for (int i = 7; i < n; i += 13) { positions[i] = -1; }
+        }
+    }
+    std::vector<float> biases(nb * nt);
+    std::vector<std::vector<int32_t>> initial_ids;
+    std::vector<std::vector<float>> initial_output;
+    for (int pass = 0; pass < 3; ++pass) {
+        const int start = pass == 2 ? 60 : 72;
+        if (pass == 2) { keys = original_keys; values = original_values; }
+        for (int t = 0; t < nt; ++t) {
+            for (int i = 0; i < n; ++i) {
+                masks[t*n + i] = ggml_fp32_to_fp16(positions[i] >= 0 && positions[i] <= start + t ? 0 : -INFINITY);
+            }
+            saker_sparse_fill_row(config, positions, masks.data() + t*n, nullptr, biases.data() + t*nb);
+        }
+        if (pass == 1) {
+            for (int i = 0; i < n; ++i) {
+                if (positions[i] < 0 || positions[i] > start) {
+                    for (int j = 0; j < d*hk; ++j) {
+                        keys[i*d*hk+j] = ggml_fp32_to_fp16(5 + j / 32.0f);
+                        values[i*d*hk+j] = ggml_fp32_to_fp16(-ggml_fp16_to_fp32(original_values[i*d*hk+j]));
+                    }
+                }
+            }
+        }
+        ggml_backend_tensor_set(q, queries.data(), 0, ggml_nbytes(q));
+        ggml_backend_tensor_set(ks, keys.data(), 0, ggml_nbytes(ks));
+        ggml_backend_tensor_set(vs, values.data(), 0, ggml_nbytes(vs));
+        ggml_backend_tensor_set(mask, masks.data(), 0, ggml_nbytes(mask));
+        ggml_backend_tensor_set(bias, biases.data(), 0, ggml_nbytes(bias));
+        if (mode == saker_sparse_mode::quest) { ggml_backend_tensor_set(pages, page_ids.data(), 0, ggml_nbytes(pages)); }
+        CHECK(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS);
+        for (int t = 0; t < nt; ++t) {
+            for (int h = 0; h < hk; ++h) {
+                const int index = t*hk+h;
+                std::vector<int32_t> ids(count), slots(config.tokens), dims(std::min(channels, d));
+                std::vector<float> actual(d*group);
+                ggml_backend_tensor_get(selections[index].blocks, ids.data(), 0, ids.size()*sizeof(int32_t));
+                ggml_backend_tensor_get(selections[index].indices, slots.data(), 0, slots.size()*sizeof(int32_t));
+                ggml_backend_tensor_get(outputs[index], actual.data(), 0, actual.size()*sizeof(float));
+                CHECK(std::set<int32_t>(ids.begin(), ids.end()).size() == ids.size());
+                CHECK(std::set<int32_t>(slots.begin(), slots.end()).size() == slots.size());
+                for (int i : slots) { CHECK(i >= 0 && i < n); }
+                for (int i = 0; i < nb; ++i) {
+                    if (biases[t*nb+i] == INFINITY) { CHECK(std::find(ids.begin(), ids.end(), i) != ids.end()); }
+                }
+                std::vector<double> score(nb, 0);
+                if (mode == saker_sparse_mode::quest) {
+                    for (int b = 0; b < nb; ++b) {
+                        double best = -INFINITY;
+                        for (int g = 0; g < group; ++g) {
+                            double bound = 0;
+                            for (int j = 0; j < d; ++j) {
+                                double low = INFINITY, high = -INFINITY;
+                                for (int i = b*16; i < (b+1)*16; ++i) {
+                                    const double key = ggml_fp16_to_fp32(keys[(i*hk+h)*d+j]);
+                                    low = std::min(low, key); high = std::max(high, key);
+                                }
+                                const double query = queries[(t*hq+h*group+g)*d+j];
+                                bound += std::max(query*low, query*high);
+                            }
+                            best = std::max(best, bound);
+                        }
+                        score[b] = best;
+                    }
+                } else {
+                    ggml_backend_tensor_get(selections[index].channels, dims.data(), 0, dims.size()*sizeof(int32_t));
+                    std::vector<double> importance(d, 0);
+                    for (int j = 0; j < d; ++j) {
+                        for (int g = 0; g < group; ++g) { importance[j] += std::abs(queries[(t*hq+h*group+g)*d+j]); }
+                    }
+                    CHECK(std::set<int32_t>(dims.begin(), dims.end()).size() == dims.size());
+                    double least = INFINITY;
+                    for (int j : dims) { CHECK(j >= 0 && j < d); least = std::min(least, importance[j]); }
+                    for (int j = 0; j < d; ++j) {
+                        if (std::find(dims.begin(), dims.end(), j) == dims.end()) { CHECK(importance[j] <= least + 1e-5); }
+                    }
+                    for (int g = 0; g < group; ++g) {
+                        double full_norm = 0, part_norm = 0;
+                        for (int j = 0; j < d; ++j) { full_norm += std::abs(queries[(t*hq+h*group+g)*d+j]); }
+                        for (int j : dims) { part_norm += std::abs(queries[(t*hq+h*group+g)*d+j]); }
+                        const double tau = std::sqrt(std::max(1e-12, d * part_norm / std::max(1e-12, full_norm)));
+                        std::vector<double> logits(n, -INFINITY);
+                        for (int i = 0; i < n; ++i) {
+                            if (!std::isfinite(ggml_fp16_to_fp32(masks[t*n+i]))) { continue; }
+                            double dot = 0;
+                            for (int j : dims) { dot += queries[(t*hq+h*group+g)*d+j] * ggml_fp16_to_fp32(keys[(i*hk+h)*d+j]); }
+                            logits[i] = dot / tau;
+                        }
+                        const auto probabilities = softmax(logits);
+                        for (int i = 0; i < n; ++i) { score[i] += probabilities[i] / group; }
+                    }
+                }
+                for (int i = 0; i < nb; ++i) { score[i] += biases[t*nb+i]; }
+                double least = INFINITY;
+                for (int i : ids) { least = std::min(least, score[i]); }
+                for (int i = 0; i < nb; ++i) {
+                    if (std::find(ids.begin(), ids.end(), i) == ids.end()) { CHECK(score[i] <= least + 2e-5); }
+                }
+                for (int g = 0; g < group; ++g) {
+                    std::vector<double> logits(n, -INFINITY);
+                    for (int i = 0; i < n; ++i) {
+                        if ((!all && std::find(slots.begin(), slots.end(), i) == slots.end()) ||
+                                !std::isfinite(ggml_fp16_to_fp32(masks[t*n+i]))) { continue; }
+                        double dot = 0;
+                        for (int j = 0; j < d; ++j) { dot += queries[(t*hq+h*group+g)*d+j] * ggml_fp16_to_fp32(keys[(i*hk+h)*d+j]); }
+                        logits[i] = dot / std::sqrt(double(d));
+                    }
+                    const auto probabilities = softmax(logits);
+                    for (int j = 0; j < d; ++j) {
+                        double expected = 0;
+                        for (int i = 0; i < n; ++i) { expected += probabilities[i] * ggml_fp16_to_fp32(values[(i*hk+h)*d+j]); }
+                        CHECK(std::isfinite(actual[g*d+j]));
+                        CHECK(std::abs(actual[g*d+j] - expected) < 0.002 * (1 + std::abs(expected)));
+                    }
+                }
+                if (pass == 0) { initial_ids.push_back(ids); initial_output.push_back(actual); }
+                if (pass == 1 && t == 0) {
+                    CHECK(ids == initial_ids[index]);
+                    for (size_t j = 0; j < actual.size(); ++j) { CHECK(std::abs(actual[j] - initial_output[index][j]) < 1e-6); }
+                }
+            }
+        }
+    }
+    ggml_backend_buffer_free(buffer);
+    ggml_free(ctx);
+}
+
+static void test_page_update(ggml_backend_t backend) {
+    constexpr int width = 64, n = 64;
+    auto * ctx = ggml_init({4 * 1024 * 1024, nullptr, true});
+    auto * keys = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, width / 2, 2, n);
+    auto * lo = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, width, n / 16);
+    auto * hi = ggml_dup_tensor(ctx, lo);
+    auto * page = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 1);
+    auto * graph = ggml_new_graph_custom(ctx, 128, false);
+    saker_quest_update(ctx, graph, keys, page, lo, hi);
+    supported(backend, graph);
+    auto buffer = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    CHECK(buffer);
+    std::vector<ggml_fp16_t> data(width*n), low(width*4, ggml_fp32_to_fp16(19)), high(low);
+    ggml_backend_tensor_set(lo, low.data(), 0, ggml_nbytes(lo));
+    ggml_backend_tensor_set(hi, high.data(), 0, ggml_nbytes(hi));
+    // Revisit pages to check that overwrites shrink bounds rather than preserving stale extrema.
+    int pass = 0;
+    for (int32_t p : {2, 0, 3, 1, 2}) {
+        ++pass;
+        for (int i = 0; i < n; ++i) {
+            for (int j = 0; j < width; ++j) { data[i*width+j] = ggml_fp32_to_fp16(((i % 16 - 8) * 0.125f + j * 0.03125f + p) / pass); }
+        }
+        ggml_backend_tensor_set(keys, data.data(), 0, ggml_nbytes(keys));
+        ggml_backend_tensor_set(page, &p, 0, sizeof(p));
+        CHECK(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS);
+        std::vector<ggml_fp16_t> actual_lo(low.size()), actual_hi(high.size());
+        ggml_backend_tensor_get(lo, actual_lo.data(), 0, ggml_nbytes(lo));
+        ggml_backend_tensor_get(hi, actual_hi.data(), 0, ggml_nbytes(hi));
+        for (int b = 0; b < 4; ++b) {
+            for (int j = 0; j < width; ++j) {
+                if (b == p) {
+                    low[b*width+j] = data[(b*16)*width+j];
+                    high[b*width+j] = data[(b*16+15)*width+j];
+                }
+                CHECK(actual_lo[b*width+j] == low[b*width+j]);
+                CHECK(actual_hi[b*width+j] == high[b*width+j]);
+            }
+        }
+    }
+    ggml_backend_buffer_free(buffer);
+    ggml_free(ctx);
+}
+
+int main(int argc, char ** argv) {
+    ggml_backend_load_all();
+    auto backend = ggml_backend_init_by_name(argc > 1 ? argv[1] : "CPU", nullptr);
+    CHECK(backend);
+    int cases = 0;
+    for (auto mode : {saker_sparse_mode::quest, saker_sparse_mode::sparq}) {
+        for (int nt : {1, 3, 8}) {
+            for (bool all : {false, true}) {
+                for (bool fragmented : {false, true}) {
+                    test_selector(backend, mode, nt, all, fragmented, 8, false);
+                    ++cases;
+                }
+            }
+        }
+    }
+    test_selector(backend, saker_sparse_mode::sparq, 3, false, true, 32, false);
+    test_selector(backend, saker_sparse_mode::sparq, 3, false, true, 8, true);
+    test_page_update(backend);
+    std::printf("PASS: %d selector cases (three cache updates each), all-channel/zero-query SparQ and incremental Quest metadata on %s\n", cases, ggml_backend_name(backend));
+    ggml_backend_free(backend);
+}
