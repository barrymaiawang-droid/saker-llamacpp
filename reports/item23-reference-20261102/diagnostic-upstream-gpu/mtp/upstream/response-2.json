  "prompt": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Pelican on a Bike \ud83d\udeb2\ud83e\udda9</title>\n<style>\n  html, body {\n    margin: 0;\n    padding: 0;\n    overflow: hidden;\n    height: 100%;\n    background: #87c5eb;\n    font-family: 'Trebuchet MS', 'Segoe UI', sans-serif;\n  }\n  #scene { position: fixed; inset: 0; }\n  .hud {\n    position: fixed;\n    top: 18px;\n    left: 50%;\n    transform: translateX(-50%);\n    color: #fff;\n    text-align: center;\n    text-shadow: 0 2px 6px rgba(0,0,0,.45);\n    pointer-events: none;\n    user-select: none;\n  }\n  .hud h1 {\n    margin: 0;\n    font-size: clamp(20px, 4vw, 34px);\n    letter-spacing: 1px;\n  }\n  .hud p {\n    margin: 4px 0 0;\n    font-size: clamp(11px, 1.8vw, 15px);\n    opacity: .9;\n  }\n</style>\n<script type=\"importmap\">\n{\n  \"imports\": {\n    \"three\": \"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js\",\n    \"three/addons/\": \"https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/\"\n  }\n}\n</script>\n</head>\n<body>\n<canvas id=\"scene\"></canvas>\n<div class=\"hud\">\n  <h1>\ud83e\udda9 Pelican on a Bike \ud83d\udeb2</h1>\n  <p>Drag to orbit &middot; Scroll to zoom</p>\n</div>\n\n<script type=\"module\">\nimport * as THREE from 'three';\nimport { OrbitControls } from 'three/addons/controls/OrbitControls.js';\n\n/* ------------------------------------------------- renderer / scene */\nconst canvas = document.getElementById('scene');\nconst renderer = new THREE.WebGLRenderer({ canvas, antialias: true });\nrenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));\nrenderer.setSize(innerWidth, innerHeight);\nrenderer.shadowMap.enabled = true;\nrenderer.shadowMap.type = THREE.PCFSoftShadowMap;\n\nconst scene = new THREE.Scene();\nscene.background = new THREE.Color(0x87c5eb);\nscene.fog = new THREE.Fog(0x87c5eb, 40, 120);\n\nconst camera = new THREE.PerspectiveCamera(55, innerWidth / innerHeight, 0.1, 500);\ncamera.position.set(4.5, 2.6, 5.5);\n\nconst controls = new OrbitControls(camera, renderer.domElement);\ncontrols.enableDamping = true;\ncontrols.dampingFactor = 0.06;\ncontrols.minDistance = 2;\ncontrols.maxDistance = 40;\ncontrols.maxPolarAngle = Math.PI * 0.495;\n\n/* ------------------------------------------------- lights */\nconst sun = new THREE.DirectionalLight(0xfff4d6, 2.2);\nsun.position.set(12, 18, 8);\nsun.castShadow = true;\nsun.shadow.mapSize.set(2048, 2048);\nsun.shadow.camera.left = -25;\nsun.shadow.camera.right = 25;\nsun.shadow.camera.top = 25;\nsun.shadow.camera.bottom = -25;\nsun.shadow.camera.far = 80;\nscene.add(sun);\nscene.add(new THREE.AmbientLight(0xbfd9ff, 0.7));\nconst hemi = new THREE.HemisphereLight(0xbfe3ff, 0x5c8a4a, 0.55);\nscene.add(hemi);\n\n/* ------------------------------------------------- ground & path */\nconst ground = new THREE.Mesh(\n  new THREE.CircleGeometry(90, 64),\n  new THREE.MeshStandardMaterial({ color: 0x67a84f, roughness: 1 })\n);\nground.rotation.x = -Math.PI / 2;\nground.receiveShadow = true;\nscene.add(ground);\n\nconst ORBIT_R = 7;\nconst path = new THREE.Mesh(\n  new THREE.RingGeometry(ORBIT_R - 0.8, ORBIT_R + 0.8, 96),\n  new THREE.MeshStandardMaterial({ color: 0xc9a86b, roughness: 1 })\n);\npath.rotation.x = -Math.PI / 2;\npath.position.y = 0.005;\npath.receiveShadow = true;\nscene.add(path);\n\n/* simple trees */\nconst trunkMat = new THREE.MeshStandardMaterial({ color: 0x7a4a26, roughness: 1 });\nconst leafMat  = new THREE.MeshStandardMaterial({ color: 0x2f7d3a, roughness: 1 });\nfunction tree(x, z, s = 1) {\n  const g = new THREE.Group();\n  const trunk = new THREE.Mesh(new THREE.CylinderGeometry(0.12*s, 0.2*s, 1.6*s, 8), trunkMat);\n  trunk.position.y = 0.8*s;\n  const crown = new THREE.Mesh(new THREE.SphereGeometry(0.9*s, 12, 10), leafMat);\n  crown.position.y = 1.9*s;\n  crown.scale.set(1, 1.25, 1);\n  g.add(trunk, crown);\n  [trunk, crown].forEach(m => { m.castShadow = true; });\n  g.position.set(x, 0, z);\n  scene.add(g);\n}\nconst treeSpots = [[14,4],[16,-3],[15,10],[-14,6],[-16,-2],[-13,-9],[10,15],[-10,14],[17,6],[-17,5]];\ntreeSpots.forEach(([x,z]) => tree(x, z, 0.8 + Math.random()*0.8));\n\n/* clouds */\nconst cloudMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 1, transparent: true, opacity: 0.95 });\nfunction cloud(x, y, z, s) {\n  const g = new THREE.Group();\n  for (let i = 0; i < 5; i++) {\n    const m = new THREE.Mesh(new THREE.SphereGeometry(0.7 * (0.6 + Math.random()*0.7), 10, 8), cloudMat);\n    m.position.set((i-2)*0.7*s, (Math.random()*0.3 - 0.15)*s, (Math.random()-0.5)*0.6*s);\n    m.scale.y = 0.6;\n    g.add(m);\n  }\n  g.position.set(x, y, z);\n  scene.add(g);\n  return g;\n}\nconst clouds = [cloud(-18, 14, -12, 1.6), cloud(14, 16, -20, 2), cloud(24, 12, 10, 1.3), cloud(-26, 15, 16, 1.8), cloud(2, 18, -30, 2.2)];\n\n/* ------------------------------------------------- helpers */\nfunction tubeBetween(a, b, radius, material) {\n  const dir = new THREE.Vector3().subVectors(b, a);\n  const len = dir.length();\n  const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius, len, 8), material);\n  mesh.position.copy(a).addScaledVector(dir, 0.5);\n  mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.normalize());\n  mesh.castShadow = true;\n  return mesh;\n}\n/* update a unit-height cylinder mesh to span a..b (built with CylinderGeometry(r, r, 1)) */\nfunction setSpan(mesh, a, b) {\n  const dir = new THREE.Vector3().subVectors(b, a);\n  const len = dir.length();\n  mesh.position.copy(a).addScaledVector(dir, 0.5);\n  mesh.scale.y = len;\n  mesh.quaternion.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir.normalize());\n}\nfunction unitCyl(radius, material) {\n  const m = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius, 1, 8), material);\n  m.castShadow = true;",
