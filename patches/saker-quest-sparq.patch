+
+// Refresh complete physical pages after cache writes. Partial pages are protected at selection time.
+inline void saker_quest_update(
+        ggml_context * ctx, ggml_cgraph * graph, ggml_tensor * k,
+        ggml_tensor * pages, ggml_tensor * minimum, ggml_tensor * maximum, int block = 16) {
+    const int64_t width = k->ne[0] * k->ne[1];
+    auto * rows = ggml_view_2d(ctx, k, width * block, k->ne[2] / block, k->nb[2] * block, 0);
