+    lo = ggml_reshape_2d(ctx, lo, width, pages->ne[0]);
+    ggml_build_forward_expand(graph, ggml_set_rows(ctx, minimum, lo, pages));
+    ggml_build_forward_expand(graph, ggml_set_rows(ctx, maximum, hi, pages));
+}
+
+// Use argsort for large budgets that exceed Vulkan's dedicated top-k kernels.
+inline ggml_tensor * saker_sparse_top_k(ggml_context * ctx, ggml_tensor * scores, int count) {
+    if (count >= 1024) {
+        return ggml_cont(ctx, ggml_view_1d(ctx, ggml_argsort(ctx, scores, GGML_SORT_ORDER_DESC), count, 0));
+    }
+    return ggml_top_k(ctx, scores, count);
+}
+
+// One KV head and its query group. Cache views retain the original interleaved head strides.
+inline saker_sparse_selection saker_sparse_select_head(
+        ggml_context * ctx, const saker_sparse_config & config,
+        ggml_tensor * q, ggml_tensor * k, ggml_tensor * v, ggml_tensor * mask,
+        ggml_tensor * bias, ggml_tensor * minimum, ggml_tensor * maximum,
+        int token, int head, bool strided_rows = true) {
+    const int64_t d = q->ne[0], n = k->ne[2], group = q->ne[1] / k->ne[1];
+    const int count = int(std::min<int64_t>(config.tokens / config.unit(), n / config.unit()));
+    auto * qi = ggml_view_3d(ctx, q, d, group, 1, q->nb[1], q->nb[2], token * q->nb[2] + head * group * q->nb[1]);
+    auto * mi = ggml_view_2d(ctx, mask, n, 1, mask->nb[1], token * mask->nb[1]);
+    auto * bi = ggml_view_1d(ctx, bias, n / config.unit(), token * bias->nb[1]);
+    auto * ki = ggml_view_2d(ctx, k, d, n, k->nb[2], head * k->nb[1]);
+    ggml_tensor * scores;
+    ggml_tensor * channels = nullptr;
+    if (config.mode == saker_sparse_mode::quest) {
+        GGML_ASSERT(minimum && maximum);
+        const int64_t pages = n / config.block;
+        auto * lo = ggml_view_2d(ctx, minimum, d, pages, minimum->nb[1], head * d * ggml_type_size(minimum->type));
+        auto * hi = ggml_view_2d(ctx, maximum, d, pages, maximum->nb[1], head * d * ggml_type_size(maximum->type));
+        auto * positive = ggml_relu(ctx, qi);
+        auto * negative = ggml_neg(ctx, ggml_relu(ctx, ggml_neg(ctx, qi)));
+        auto * upper = ggml_mul_mat(ctx, hi, positive);
+        auto * lower = ggml_mul_mat(ctx, lo, negative);
+        ggml_mul_mat_set_prec(upper, GGML_PREC_F32);
+        ggml_mul_mat_set_prec(lower, GGML_PREC_F32);
+        scores = ggml_add(ctx, upper, lower);
+        scores = ggml_pool_2d(ctx, scores, GGML_OP_POOL_MAX, 1, int(group), 1, int(group), 0, 0);
+        scores = ggml_reshape_1d(ctx, scores, pages);
+    } else {
+        GGML_ASSERT(config.mode == saker_sparse_mode::sparq);
+        auto * magnitude = ggml_abs(ctx, qi);
+        auto * importance = ggml_pool_2d(ctx, magnitude, GGML_OP_POOL_AVG, 1, int(group), 1, int(group), 0, 0);
+        channels = saker_sparse_top_k(ctx, ggml_reshape_1d(ctx, importance, d), std::min<int64_t>(config.channels, d));
+        auto * qt = ggml_transpose(ctx, qi);
+        auto * kt = ggml_transpose(ctx, ki);
+        if (!strided_rows) {
+            qt = ggml_cont(ctx, qt);
+            kt = ggml_cont(ctx, kt);
+        }
+        auto * qs = ggml_cont(ctx, ggml_transpose(ctx, ggml_get_rows(ctx, qt, channels)));
+        auto * ks = ggml_cont(ctx, ggml_transpose(ctx, ggml_get_rows(ctx, kt, channels)));
+        auto * full_norm = ggml_clamp(ctx, ggml_sum_rows(ctx, magnitude), 1e-12f, INFINITY);
+        auto * part_norm = ggml_sum_rows(ctx, ggml_abs(ctx, qs));
+        auto * tau = ggml_sqrt(ctx, ggml_clamp(ctx, ggml_scale(ctx, ggml_div(ctx, part_norm, full_norm), float(d)), 1e-12f, INFINITY));
+        scores = ggml_mul_mat(ctx, ks, qs);
+        ggml_mul_mat_set_prec(scores, GGML_PREC_F32);
+        // Broadcast the per-head temperature over the sequence axis.
+        scores = ggml_div(ctx, scores, ggml_repeat(ctx, tau, scores));
+        scores = ggml_soft_max(ctx, ggml_add(ctx, scores, ggml_cast(ctx, mi, GGML_TYPE_F32)));
+        scores = ggml_pool_2d(ctx, scores, GGML_OP_POOL_AVG, 1, int(group), 1, int(group), 0, 0);
+        scores = ggml_reshape_1d(ctx, scores, n);
+    }
+    auto * selected = saker_sparse_top_k(ctx, ggml_add(ctx, scores, bi), count);
+    ggml_tensor * indices = selected;
+    if (config.mode == saker_sparse_mode::quest) {
+        auto * starts = ggml_reshape_2d(ctx, ggml_scale(ctx, ggml_cast(ctx, selected, GGML_TYPE_F32), float(config.block)), 1, count);
+        auto * offsets = ggml_arange(ctx, 0, float(config.block), 1);
+        auto * shape = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, config.block, count);
+        auto * slots = ggml_add(ctx, ggml_repeat(ctx, starts, shape), offsets);
+        indices = ggml_cast(ctx, ggml_reshape_1d(ctx, slots, count * config.block), GGML_TYPE_I32);
+    }
+    const auto gather = [&](ggml_tensor * cache) {
+        auto * rows = ggml_view_2d(ctx, cache, cache->ne[0], n, cache->nb[2], head * cache->nb[1]);
+        auto * compact = ggml_cast(ctx, ggml_get_rows(ctx, rows, indices), GGML_TYPE_F16);
+        return ggml_reshape_3d(ctx, compact, cache->ne[0], 1, indices->ne[0]);
+    };
+    auto * mask_rows = ggml_reshape_2d(ctx, mi, 1, n);
+    auto * selected_mask = ggml_cast(ctx, ggml_reshape_2d(ctx, ggml_get_rows(ctx, mask_rows, indices), indices->ne[0], 1), GGML_TYPE_F16);
+    return {qi, gather(k), gather(v), selected_mask, selected, indices, channels};
+}
