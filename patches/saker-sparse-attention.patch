+#include <set>
+
+#define CHECK(x) do { if (!(x)) { std::fprintf(stderr, "FAIL line %d: %s\n", __LINE__, #x); std::abort(); } } while (0)
+
+static void test_case(ggml_backend_t backend, int n_queries, bool all_blocks, bool fragmented) {
+    constexpr int d = 32, hq = 4, hk = 2, n = 96, capacity = 128;
+    saker_sparse_config config;
+    config.tokens = all_blocks ? n : 48;
+    config.recent_blocks = 1;
+    config.sink_blocks = 1;
+    const int nb = n / config.block, selected_count = config.tokens / config.block;
+    ggml_context * ctx = ggml_init({16 * 1024 * 1024, nullptr, true});
+    CHECK(ctx);
+    auto * q = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, d, hq, n_queries);
+    auto * ks = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, d, hk, capacity);
+    auto * vs = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, d, hk, capacity);
+    auto * k = ggml_view_4d(ctx, ks, d, hk, n, 1, d * 2, d * hk * 2, capacity * d * hk * 2, 0);
+    auto * v = ggml_view_4d(ctx, vs, d, hk, n, 1, d * 2, d * hk * 2, capacity * d * hk * 2, 0);
+    auto * mask = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, n, n_queries);
+    auto * reps = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, nb, n_queries);
+    auto * bias = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, nb, n_queries);
+    auto * graph = ggml_new_graph_custom(ctx, 2048, false);
+    std::vector<saker_sparse_selection> selections;
+    std::vector<ggml_tensor *> outputs;
+    for (int t = 0; t < n_queries; ++t) {
+        auto selected = saker_sparse_select(ctx, config, q, k, v, mask, reps, bias, t);
+        auto * out = ggml_flash_attn_ext(ctx,
+                ggml_permute(ctx, selected.q, 0, 2, 1, 3),
+                ggml_permute(ctx, selected.k, 0, 2, 1, 3),
+                ggml_permute(ctx, selected.v, 0, 2, 1, 3), selected.mask, 1.0f / std::sqrt(float(d)), 0, 0);
+        ggml_flash_attn_ext_set_prec(out, GGML_PREC_F32);
+        ggml_build_forward_expand(graph, out);
+        selections.push_back(selected);
+        outputs.push_back(out);
+    }
+    for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+        auto * node = ggml_graph_node(graph, i);
+        if (!ggml_backend_supports_op(backend, node)) {
+            std::fprintf(stderr, "unsupported on %s: %s\n", ggml_backend_name(backend), ggml_op_name(node->op));
+            CHECK(false);
+        }
+    }
+    auto buffer = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    CHECK(buffer);
+    std::mt19937 random(41);
+    std::uniform_real_distribution<float> uniform(-0.7f, 0.7f);
+    std::vector<float> queries(d * hq * n_queries);
+    std::vector<ggml_fp16_t> keys(d * hk * capacity), values(keys.size()), masks(n * n_queries);
+    for (auto & x : queries) { x = uniform(random); }
+    for (auto & x : keys) { x = ggml_fp32_to_fp16(uniform(random)); }
+    for (auto & x : values) { x = ggml_fp32_to_fp16(uniform(random)); }
+    const auto original_keys = keys;
+    const auto original_values = values;
+    std::vector<int32_t> positions(n), representatives(nb * n_queries);
+    std::vector<float> biases(nb * n_queries);
+    std::iota(positions.begin(), positions.end(), 0);
+    if (fragmented) {
+        std::shuffle(positions.begin(), positions.end(), random);
+        for (int i = 7; i < n; i += 13) { positions[i] = -1; }
+    }
+    std::vector<std::vector<float>> first_outputs;
+    std::vector<std::vector<int32_t>> first_selected;
+    for (int pass = 0; pass < 3; ++pass) {
+        // Reuse this graph after changing mask/positions and overwriting cache values.
+        const int query_start = pass == 2 ? 60 : 72;
+        if (pass == 2) {
+            keys = original_keys;
+            values = original_values;
+            std::rotate(positions.begin(), positions.begin() + 9, positions.end());
+        }
+        for (int t = 0; t < n_queries; ++t) {
+            for (int i = 0; i < n; ++i) {
+                const bool visible = positions[i] >= 0 && positions[i] <= query_start + t;
+                masks[t * n + i] = ggml_fp32_to_fp16(visible ? 0.0f : -INFINITY);
+            }
+            saker_sparse_fill_row(config, positions, masks.data() + t * n,
+                    representatives.data() + t * nb, biases.data() + t * nb);
+            for (int b = 0; b < nb; ++b) {
+                const int r = representatives[t * nb + b];
+                CHECK(r >= 0 && r < n);
+                CHECK(std::isfinite(ggml_fp16_to_fp32(masks[t * n + r])));
+            }
+        }
+        if (pass == 1) {
+            // These slots are invisible to the first query, even if later queries can use them.
+            for (int i = 0; i < n; ++i) {
+                if (positions[i] < 0 || positions[i] > query_start) {
+                    for (int j = 0; j < d * hk; ++j) {
+                        keys[i * d * hk + j] = ggml_fp32_to_fp16(5.0f + j / 32.0f);
+                        values[i * d * hk + j] = ggml_fp32_to_fp16(-ggml_fp16_to_fp32(original_values[i * d * hk + j]));
+                    }
+                }
+            }
+        }
+        ggml_backend_tensor_set(q, queries.data(), 0, ggml_nbytes(q));
+        ggml_backend_tensor_set(ks, keys.data(), 0, ggml_nbytes(ks));
+        ggml_backend_tensor_set(vs, values.data(), 0, ggml_nbytes(vs));
+        ggml_backend_tensor_set(mask, masks.data(), 0, ggml_nbytes(mask));
+        ggml_backend_tensor_set(reps, representatives.data(), 0, ggml_nbytes(reps));
+        ggml_backend_tensor_set(bias, biases.data(), 0, ggml_nbytes(bias));
+        CHECK(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS);
+        for (int t = 0; t < n_queries; ++t) {
+            std::vector<int32_t> selected(selected_count);
+            std::vector<float> actual(d * hq);
+            ggml_backend_tensor_get(selections[t].blocks, selected.data(), 0, selected.size() * sizeof(int32_t));
+            ggml_backend_tensor_get(outputs[t], actual.data(), 0, actual.size() * sizeof(float));
+            CHECK(std::set<int32_t>(selected.begin(), selected.end()).size() == selected.size());
+            for (int b : selected) { CHECK(b >= 0 && b < nb); }
+            for (int b = 0; b < nb; ++b) {
+                if (biases[t * nb + b] == INFINITY) {
+                    CHECK(std::find(selected.begin(), selected.end(), b) != selected.end());
+                }
+            }
+            // Independent scalar reference for selection and attention.
+            std::vector<double> scores(nb, -INFINITY);
+            for (int b = 0; b < nb; ++b) {
+                double best = -INFINITY;
+                for (int h = 0; h < hq; ++h) {
+                    double dot = 0;
+                    for (int j = 0; j < d; ++j) {
+                        dot += queries[t * d * hq + h * d + j] *
+                               ggml_fp16_to_fp32(keys[(representatives[t * nb + b] * hk + h / (hq / hk)) * d + j]);
+                    }
+                    best = std::max(best, dot);
+                }
+                scores[b] = best + biases[t * nb + b];
+            }
+            double minimum = INFINITY;
+            for (int b : selected) { minimum = std::min(minimum, scores[b]); }
+            for (int b = 0; b < nb; ++b) {
+                if (std::find(selected.begin(), selected.end(), b) == selected.end()) {
+                    CHECK(scores[b] <= minimum + 1e-4);
+                }
+            }
+            for (int h = 0; h < hq; ++h) {
+                std::vector<double> logits(n, -INFINITY);
+                double maximum = -INFINITY;
+                for (int i = 0; i < n; ++i) {
+                    if ((!all_blocks && std::find(selected.begin(), selected.end(), i / config.block) == selected.end()) ||
+                            !std::isfinite(ggml_fp16_to_fp32(masks[t * n + i]))) { continue; }
+                    double dot = 0;
+                    for (int j = 0; j < d; ++j) {
+                        dot += queries[t * d * hq + h * d + j] * ggml_fp16_to_fp32(keys[(i * hk + h / (hq / hk)) * d + j]);
+                    }
+                    logits[i] = dot / std::sqrt(double(d));
+                    maximum = std::max(maximum, logits[i]);
+                }
+                double total = 0;
+                for (auto & x : logits) { x = std::exp(x - maximum); total += x; }
+                for (int j = 0; j < d; ++j) {
+                    double reference = 0;
+                    for (int i = 0; i < n; ++i) {
+                        reference += logits[i] * ggml_fp16_to_fp32(values[(i * hk + h / (hq / hk)) * d + j]);
+                    }
+                    reference /= total;
+                    CHECK(std::isfinite(actual[h * d + j]));
+                    if (std::abs(actual[h * d + j] - reference) >= 0.002 * (1 + std::abs(reference))) {
+                        std::fprintf(stderr, "queries=%d all=%d frag=%d pass=%d t=%d h=%d j=%d actual=%g ref=%g blocks=", n_queries, all_blocks, fragmented, pass, t, h, j, actual[h*d+j], reference);
+                        for (int b : selected) { std::fprintf(stderr, " %d", b); }
+                        std::fprintf(stderr, "\n");
+                    }
+                    CHECK(std::abs(actual[h * d + j] - reference) < 0.002 * (1 + std::abs(reference)));
+                }
+            }
+            if (pass == 0) {
+                first_outputs.push_back(actual);
+                first_selected.push_back(selected);
+            } else if (pass == 1 && t == 0) {
+                CHECK(selected == first_selected[t]);
+                for (size_t j = 0; j < actual.size(); ++j) { CHECK(std::abs(actual[j] - first_outputs[t][j]) < 1e-6); }
+            }
+        }
+    }
+    ggml_backend_buffer_free(buffer);
+    ggml_free(ctx);
+}
+
+int main(int argc, char ** argv) {
+    if (argc == 2 && std::string(argv[1]) == "--config") {
+        try {
+            std::printf("tokens=%d\n", saker_sparse_options().tokens);
+            return 0;
+        } catch (const std::exception & error) {
+            std::fprintf(stderr, "%s\n", error.what());
+            return 1;
+        }
+    }
+    ggml_backend_load_all();
+    auto backend = ggml_backend_init_by_name(argc > 1 ? argv[1] : "CPU", nullptr);
+    CHECK(backend);
+    int cases = 0;
+    for (int queries : {1, 3, 8}) {
+        for (bool all : {false, true}) {
+            for (bool fragmented : {false, true}) {
+                test_case(backend, queries, all, fragmented);
+                ++cases;
+            }
+        }
+    }
+    std::printf("PASS: %d sparse graph cases on %s (three cache updates each)\n", cases, ggml_backend_name(backend));
+    ggml_backend_free(backend);
+}
