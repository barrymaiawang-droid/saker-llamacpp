+// saker: SAKER_OP_TRACE per-node timing (forces sync per op; use for attribution only)
+#include <map>
+#include <algorithm>
+#include <string>
+#include <vector>
+static bool saker_op_trace_on() { static const bool v = getenv("SAKER_OP_TRACE") != nullptr; return v; }
+struct saker_op_stat { double us = 0; int64_t n = 0; };
+static std::map<std::string, saker_op_stat> saker_op_acc;
+static int64_t saker_op_graphs = 0;
+static bool saker_op_dump_on() { static const bool v = getenv("SAKER_CTX_DUMP") != nullptr; return v; }
+static int saker_nd_seen = 0;
+static bool saker_op_cb(struct ggml_tensor * t, bool ask, void *) {
+    if (ask) {
+        if (saker_op_dump_on() && saker_nd_seen < 4500) {
+            fprintf(stderr, "saker-nd: %d %s|%s\n", saker_nd_seen, ggml_op_name(t->op), t->name[0] ? t->name : "-");
+            saker_nd_seen++;
+        }
+        return true;
+    }
+    static thread_local int64_t t0 = 0;
+    int64_t now = ggml_time_us();
+    if (t0) {
+        auto & st = saker_op_acc[std::string(ggml_op_name(t->op)) + "|" + std::string(t->name[0] ? t->name : "-")];
+        st.us += (now - t0); st.n++;
+    }
+    t0 = now;
+    return true;
+}
+static void saker_op_report(int64_t graphs) {
+    fprintf(stderr, "saker-op: ==== per-op report after %lld graphs (top 25 by us) ====\n", (long long) graphs);
+    std::vector<std::pair<double, const std::string *>> v;
+    for (auto & kv : saker_op_acc) v.push_back({kv.second.us, &kv.first});
+    std::sort(v.begin(), v.end(), [](auto & a, auto & b){ return a.first > b.first; });
+    for (int i = 0; i < 25 && i < (int) v.size(); i++) {
+        for (auto & kv : saker_op_acc) if (&kv.first == v[i].second)
+            fprintf(stderr, "saker-op: %10.0f us  n=%-5lld  %s\n", kv.second.us, (long long) kv.second.n, kv.first.c_str());
+    }
+}
